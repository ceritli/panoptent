{
  "name": "panoptent",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.10.0",
  "publisher": "ceritli",
  "author": {
    "name": "Fatih Ceritli",
    "url": "https://github.com/ceritli"
  },
  "contributors": [
    {
      "name": "Alper LÜLE"
    }
  ],
  "license": "MIT",
  "homepage": "https://ceritli.github.io/panoptent/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceritli/panoptent.git"
  },
  "bugs": {
    "url": "https://github.com/ceritli/panoptent/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#14171c",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "visual edit",
    "claude",
    "claude code",
    "ai",
    "react",
    "vue",
    "next",
    "nuxt",
    "inspector",
    "emergent",
    "click to edit",
    "visual editor",
    "webview",
    "tailwind",
    "vite"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "panoptent.open",
        "title": "%command.open%",
        "icon": "$(eye)",
        "category": "Panoptent"
      },
      {
        "command": "panoptent.toggleSelect",
        "title": "%command.toggleSelect%",
        "category": "Panoptent"
      },
      {
        "command": "panoptent.setupGuide",
        "title": "%command.setupGuide%",
        "category": "Panoptent"
      },
      {
        "command": "panoptent.setupCodeInspector",
        "title": "%command.setupCodeInspector%",
        "category": "Panoptent"
      },
      {
        "command": "panoptent.chromeStatus",
        "title": "%command.chromeStatus%",
        "category": "Panoptent"
      },
      {
        "command": "panoptent.forgetChrome",
        "title": "%command.forgetChrome%",
        "category": "Panoptent"
      },
      {
        "command": "panoptent.changeLanguage",
        "title": "%command.changeLanguage%",
        "category": "Panoptent"
      },
      {
        "command": "panoptent.copyMcpCommand",
        "title": "%command.copyMcpCommand%",
        "category": "Panoptent"
      }
    ],
    "keybindings": [
      {
        "command": "panoptent.toggleSelect",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "activeWebviewPanelId == panoptent.preview"
      }
    ],
    "configuration": {
      "title": "Panoptent",
      "properties": {
        "panoptent.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "tr"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "Türkçe"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "panoptent.defaultUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "%config.defaultUrl%"
        },
        "panoptent.sendTo": {
          "type": "string",
          "enum": [
            "claudePanel",
            "cli"
          ],
          "enumDescriptions": [
            "%config.sendTo.claudePanel%",
            "%config.sendTo.cli%"
          ],
          "default": "claudePanel",
          "description": "%config.sendTo%"
        },
        "panoptent.openSourceOnSelect": {
          "type": "boolean",
          "default": true,
          "description": "%config.openSourceOnSelect%"
        },
        "panoptent.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "%config.claudePath%"
        },
        "panoptent.permissionMode": {
          "type": "string",
          "enum": [
            "acceptEdits",
            "default",
            "plan",
            "auto",
            "bypassPermissions"
          ],
          "default": "acceptEdits",
          "description": "%config.permissionMode%"
        },
        "panoptent.model": {
          "type": "string",
          "default": "",
          "description": "%config.model%"
        },
        "panoptent.reloadAfterEdit": {
          "type": "boolean",
          "default": false,
          "description": "%config.reloadAfterEdit%"
        },
        "panoptent.chromeBridge": {
          "type": "boolean",
          "default": true,
          "description": "%config.chromeBridge%"
        },
        "panoptent.bridgePort": {
          "type": "number",
          "default": 47811,
          "description": "%config.bridgePort%"
        },
        "panoptent.mcpServer": {
          "type": "boolean",
          "default": true,
          "description": "%config.mcpServer%"
        },
        "panoptent.mcpPort": {
          "type": "number",
          "default": 47821,
          "description": "%config.mcpPort%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "panoptent",
          "title": "Panoptent",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "panoptent": [
        {
          "id": "panoptent.home",
          "name": "%view.home%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "panoptent.home",
        "contents": "%view.home.welcome%"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p .",
    "package": "npm run build && vsce package --no-dependencies",
    "package:chrome": "sh chrome/build.sh"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0",
    "ws": "^8.22.0",
    "@vscode/vsce": "^3.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "preview": true
}
